// ============================================================
// 2. PRODUCT-SPECIFIC WHATSAPP INQUIRY BUTTONS
// ============================================================
function attachProductWAButtons() {
  // data-wa-product attribute on any element triggers product-specific WA message
  document.querySelectorAll('[data-wa-product]').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      const product = this.dataset.waProduct;
      const msg = `Hello, I am interested in *${product}* from Bharat TradeLink. Please share the price, MOQ, and export details.`;
      openWhatsApp(msg);
    });
  });
}

// ============================================================
// 3. CONTACT / INQUIRY FORM → WHATSAPP REDIRECT
// ============================================================
function attachFormWARedirect() {
  document.querySelectorAll('.js-form').forEach(form => {
    form.addEventListener('submit', function(e) {
      e.preventDefault();

      const btn = form.querySelector('button[type="submit"]');
      const originalText = btn.textContent;
      btn.textContent = 'Sending…';
      btn.disabled = true;

      // Gather field values
      const name    = (form.querySelector('[name="name"], input[placeholder*="Name"], input[placeholder*="name"]') || {}).value || '';
      const email   = (form.querySelector('[name="email"], input[type="email"]') || {}).value || '';
      const country = (form.querySelector('[name="country"], select') || {}).value || '';
      const product = (form.querySelector('[name="product"], select') ? [...form.querySelectorAll('select')].find(s => s.name === 'product' || s.id === 'product') : null)?.value || '';
      const message = (form.querySelector('textarea') || {}).value || '';

      // Build smart WA message
      let waMsg = `Hello Bharat TradeLink! 🇮🇳\n\n`;
      if (name)    waMsg += `*Name:* ${name}\n`;
      if (email)   waMsg += `*Email:* ${email}\n`;
      if (country) waMsg += `*Country:* ${country}\n`;
      if (product) waMsg += `*Product Interest:* ${product}\n`;
      if (message) waMsg += `\n*Message:*\n${message}`;
      waMsg += `\n\nPlease share details and pricing.`;

      setTimeout(() => {
        // Show success message if element exists
        const successEl = form.querySelector('.success-msg') || document.getElementById('successMsg');
        if (successEl) {
          successEl.style.display = 'block';
          successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        form.reset();
        btn.textContent = originalText;
        btn.disabled = false;

        // Open WhatsApp with form data
        setTimeout(() => openWhatsApp(waMsg), 600);
      }, 1000);
    });
  });
}

// ============================================================
// 4. NAVBAR — sticky shadow + hamburger
// ============================================================
function initNavbar() {
  const navbar = document.getElementById('navbar');
  if (navbar) {
    window.addEventListener('scroll', () => {
      navbar.classList.toggle('scrolled', window.scrollY > 10);
    });
  }
  const hamburger = document.getElementById('hamburger');
  const navLinks  = document.getElementById('nav-links');
  if (hamburger && navLinks) {
    hamburger.addEventListener('click', () => navLinks.classList.toggle('open'));
    navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => navLinks.classList.remove('open')));
  }
}

// ============================================================
// 5. SCROLL ANIMATIONS (Intersection Observer)
// ============================================================
function initFadeUp() {
  const els = document.querySelectorAll('.fade-up');
  if (!els.length) return;
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
  }, { threshold: 0.1 });
  els.forEach(el => obs.observe(el));
}

// ============================================================
// 6. PRODUCT FILTER (products page)
// ============================================================
function initProductFilter() {
  const btns  = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.prod-card');
  if (!btns.length || !cards.length) return;
  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      btns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const f = btn.dataset.filter;
      cards.forEach(c => { c.style.display = (f === 'all' || c.dataset.category === f) ? '' : 'none'; });
    });
  });
}

// ============================================================
// 7. SMOOTH ANCHOR SCROLLING
// ============================================================
function initSmoothScroll() {
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
      const target = document.querySelector(a.getAttribute('href'));
      if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth' }); }
    });
  });
}

// ============================================================
// INIT — run everything on DOMContentLoaded
// ============================================================
document.addEventListener('DOMContentLoaded', () => {
  injectFloatingWA();
  attachProductWAButtons();
  attachFormWARedirect();
  initNavbar();
  initFadeUp();
  initProductFilter();
  initSmoothScroll();
});
