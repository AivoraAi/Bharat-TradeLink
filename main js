// ── CONFIGURATION — change phone number here only ──────────
const WA_NUMBER = '919999999999'; // Format: country code + number, no + or spaces
const WA_DEFAULT_MSG = 'Hello, I am interested in your export products. Please share details.';

// ── Build a WhatsApp URL ────────────────────────────────────
function waURL(msg) {
  return `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(msg)}`;
}

// ── Open WhatsApp ───────────────────────────────────────────
function openWhatsApp(msg) {
  window.open(waURL(msg || WA_DEFAULT_MSG), '_blank');
}

